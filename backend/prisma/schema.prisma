// backend/prisma/schema.prisma — GlowManager Pro
// Modelos basados en la maqueta aprobada por el cliente

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  // "native" para desarrollo local (Windows)
  // "linux-musl-openssl-3.0.x" para Alpine Linux (Docker)
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

// ─────────────────────────────────────────────
// AUTENTICACIÓN
// ─────────────────────────────────────────────

model Usuario {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  nombre    String
  password  String   // hash bcrypt
  rol       String   @default("ADMIN") // ADMIN | VENDEDOR
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────
// INVENTARIO — Productos y Lotes
// ─────────────────────────────────────────────

model Producto {
  id          Int         @id @default(autoincrement())
  codigo      String      @unique
  nombre      String
  categoria   String      // texto libre, categorías se derivan con DISTINCT
  precio      Decimal     @db.Decimal(10, 2) // precio de venta en S/
  vencimiento String?     // formato "dd/mm/yyyy", null si no aplica
  activo      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  lotes          Lote[]
  itemsVenta     ItemVenta[]
  citaInsumos    CitaInsumo[]
  gastosInternos GastoInterno[]
}

// Cada lote representa una compra de mercadería.
// Un producto puede tener múltiples lotes con distintos costos.
model Lote {
  id           Int      @id @default(autoincrement())
  productoId   Int
  producto     Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  costo        Decimal  @db.Decimal(10, 2) // precio de compra por unidad en S/
  stockInicial Int      // unidades al ingresar el lote (para cálculo de inversión)
  stockActual  Int      // unidades disponibles actualmente
  createdAt    DateTime @default(now())
}

// ─────────────────────────────────────────────
// CRM — Clientes
// ─────────────────────────────────────────────

model Cliente {
  id              Int          @id @default(autoincrement())
  dni             String       @unique
  nombre          String
  telefono        String?
  correo          String?
  fechaNacimiento String?      // Opcional: fecha de nacimiento en formato YYYY-MM-DD
  totalComprado   Decimal      @default(0) @db.Decimal(10, 2)
  puntosFidelidad Int          @default(0) // 1 punto por cada S/ 10 de compra
  activo          Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  ventas          Venta[]
  citas           Cita[]
  historialPuntos HistorialPuntos[]
}

// ─────────────────────────────────────────────
// POS — Ventas e Items de Venta
// ─────────────────────────────────────────────

model Venta {
  id                Int            @id @default(autoincrement())
  fecha             DateTime       @default(now())
  clienteNombre     String         // siempre presente ("Cliente Anónimo" si no registrado)
  clienteId         Int?           // opcional: link al cliente registrado en CRM
  cliente           Cliente?       @relation(fields: [clienteId], references: [id])
  metodoPago        String         // "Efectivo" | "Yape" | "Plin" | "Transferencia" | "Pago Mixto"
  total             Decimal        @db.Decimal(10, 2)
  puntos            Int            @default(0)
  descuentoPuntos   Decimal        @default(0) @db.Decimal(10, 2)
  llevaBolsa        Boolean        @default(false)
  citaId            Int?           @unique // Relación con Cita
  cita              Cita?          @relation(fields: [citaId], references: [id], onDelete: SetNull)

  // Campos para control de boutique y facturación
  tipoVenta         String         @default("CONTADO") // "CONTADO" | "CREDITO"
  tipoComprobante   String         @default("TICKET") // "TICKET" | "BOLETA" | "FACTURA"
  numeroComprobante String?
  montoEfectivo     Decimal        @default(0) @db.Decimal(10, 2)
  montoDigital      Decimal        @default(0) @db.Decimal(10, 2)
  metodoPagoDigital String?
  saldoPendiente    Decimal        @default(0) @db.Decimal(10, 2)
  estadoCredito     String?        // "PENDIENTE" | "PAGADO"
  cajaSesionId      Int?
  cajaSesion        CajaSesion?    @relation(fields: [cajaSesionId], references: [id], onDelete: SetNull)
  abonosCredito     AbonoCredito[]

  items             ItemVenta[]
}

// Líneas del ticket de venta
model ItemVenta {
  id             Int      @id @default(autoincrement())
  ventaId        Int
  venta          Venta    @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  productoId     Int
  producto       Producto @relation(fields: [productoId], references: [id])
  nombreProducto String   // copia del nombre en el momento de la venta
  cantidad       Int
  precioUnitario Decimal  @db.Decimal(10, 2)
  costoUnitario  Decimal  @db.Decimal(10, 2) // para cálculo de ganancia neta por lote
}

// ─────────────────────────────────────────────
// AGENDA — Citas
// ─────────────────────────────────────────────

model Cita {
  id                Int           @id @default(autoincrement())
  fecha             DateTime
  clienteNombre     String
  clienteId         Int?          // opcional: link al cliente registrado
  cliente           Cliente?      @relation(fields: [clienteId], references: [id])
  servicio          String
  estado            String        @default("Pendiente") // "Pendiente" | "Completado" | "Cancelado" | "Anulado"
  notas             String?
  precioServicio    Decimal       @default(0) @db.Decimal(10, 2)
  montoAdelanto     Decimal       @default(20.00) @db.Decimal(10, 2)
  comprobanteUrl    String?
  metodoPagoReserva String?
  ingresoRegistrado Boolean       @default(false)
  personalId        Int?
  personal          Personal?     @relation(fields: [personalId], references: [id], onDelete: SetNull)
  insumos           CitaInsumo[]
  venta             Venta?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model CitaInsumo {
  id         Int      @id @default(autoincrement())
  citaId     Int
  cita       Cita     @relation(fields: [citaId], references: [id], onDelete: Cascade)
  productoId Int
  producto   Producto @relation(fields: [productoId], references: [id])
  cantidad   Int
}

// ─────────────────────────────────────────────
// SERVICIOS — Catálogo Oficial
// ─────────────────────────────────────────────

model Servicio {
  id          Int      @id @default(autoincrement())
  nombre      String
  categoria   String   @default("General") // "Maquillaje", "Peinado", "Cejas", "Uñas", "Packs"
  precio      Decimal  @db.Decimal(10, 2)
  duracion    String?  @default("45 min")
  descripcion String?
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─────────────────────────────────────────────
// PERSONAL — Estilistas y Colaboradoras
// ─────────────────────────────────────────────

model Personal {
  id          Int      @id @default(autoincrement())
  nombre      String
  telefono    String?
  cargo       String   // "Maquilladora", "Estilista", "Cosmetóloga", "Manicurista"
  activo      Boolean  @default(true)
  citas       Cita[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─────────────────────────────────────────────
// CAJA — Sesiones de Apertura y Cierre
// ─────────────────────────────────────────────

model CajaSesion {
  id            Int       @id @default(autoincrement())
  montoApertura Decimal   @db.Decimal(10, 2)
  montoCierre   Decimal?  @db.Decimal(10, 2)
  diferencia    Decimal?  @db.Decimal(10, 2)
  estado        String    @default("ABIERTA") // "ABIERTA" | "CERRADA"
  fechaApertura DateTime  @default(now())
  fechaCierre   DateTime?
  notas         String?
  ventas        Venta[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ─────────────────────────────────────────────
// CRÉDITOS — Abonos a Cuenta
// ─────────────────────────────────────────────

model AbonoCredito {
  id         Int      @id @default(autoincrement())
  ventaId    Int
  venta      Venta    @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  monto      Decimal  @db.Decimal(10, 2)
  metodoPago String   // "Efectivo", "Yape", "Plin", "Tarjeta", "Transferencia"
  fecha      DateTime @default(now())
  notas      String?
}

// ─────────────────────────────────────────────
// PROMOCIONES Y PACKS PERSONALIZADOS
// ─────────────────────────────────────────────

model PackPromocion {
  id          Int      @id @default(autoincrement())
  nombre      String
  descripcion String?
  precioPromo Decimal  @db.Decimal(10, 2)
  itemsJson   String   // JSON string: [{ id, nombre, tipo, cantidad, precioOriginal }]
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─────────────────────────────────────────────
// GASTOS INTERNOS — Consumibles e Insumos
// ─────────────────────────────────────────────

model GastoInterno {
  id              Int       @id @default(autoincrement())
  categoria       String    // "Publicidad" | "Productos de Limpieza" | "Cortesías al Cliente" | "Otros Gastos"
  item            String
  cantidadInicial Int
  cantidadActual  Int
  costoTotal      Decimal   @db.Decimal(10, 2)
  fechaIngreso    DateTime  @default(now())
  fechaFin        DateTime?
  diasDuracion    Int?      // calculado al agotar el stock
  productoId      Int?      // link opcional a un producto del inventario
  producto        Producto? @relation(fields: [productoId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// ─────────────────────────────────────────────
// CRM — Historial de Auditoría de Puntos
// ─────────────────────────────────────────────

model HistorialPuntos {
  id        Int      @id @default(autoincrement())
  clienteId Int
  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  puntos    Int      // positivo para acumulación, negativo para redención/canje
  concepto  String   // "Acumulación por Venta", "Canje en Venta", etc.
  ventaId   Int?     // link opcional a la venta que originó la transacción de puntos
  fecha     DateTime @default(now())
}
